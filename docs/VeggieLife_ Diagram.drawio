                    <mxGeometry x="35" y="813" width="210" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-11" value="Đồng ý/Từ chối Đăng nhập/Đăng ký?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.4;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
