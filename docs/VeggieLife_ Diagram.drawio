                    <mxGeometry x="3767" y="1547" width="1177" height="3280" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-2" value="Unauthorized User (Guest) / New Member (Actor)" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" parent="c09A5CiMH4nLQF5eZN43-1" vertex="1">
                    <mxGeometry y="32" width="280" height="3248" as="geometry"/>
