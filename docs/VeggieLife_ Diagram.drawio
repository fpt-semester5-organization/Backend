        </mxCell>
        <mxCell id="cell_38_lbl" value="Flow Final (Hoàn tất câu hỏi, sẵn sàng tiếp tục)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444444;fontStyle=1;" vertex="1" parent="lane_SWP391_GUEST_03_0">
          <mxGeometry x="97.0" y="1666" width="86" height="18" as="geometry" />
        </mxCell>
        <mxCell id="cell_39" value="15b. Khóa ô nhập tin nhắn, hiển thị cảnh báo chạm trần 5 câu (BR2-A)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="1588" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_40" value="16. Hiển thị Modal Popup CTA: 'Đăng ký tài khoản để hỏi AI không giới hạn'" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="1658" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_41" value="17. Bấm nút 'Đăng ký ngay' trên Modal Popup để tiếp tục" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_0">
