                <mxCell id="pool_SWP391_GUEST_03" value="[SWP391-GUEST-03] Trò Chuyện &amp; Hỏi Đáp Cùng AI Nutrition Chatbot (Tư Vấn Dinh Dưỡng, Calo/BMI &amp; Nguyên Liệu Thay Thế)" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=32;horizontal=1;horizontalStack=1;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#333333;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" parent="1" vertex="1">
