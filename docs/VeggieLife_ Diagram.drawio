                <mxCell id="c09A5CiMH4nLQF5eZN43-46" value="20a. Tính toán tự động BMI,&lt;br&gt;BMR &amp;amp; TDEE theo chuẩn WHO" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-37" vertex="1">
