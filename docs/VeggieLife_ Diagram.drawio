        <mxCell id="pool_SWP391_GUEST_03" value="[SWP391-GUEST-03] Trò Chuyện &amp; Hỏi Đáp Cùng AI Nutrition Chatbot (Tư Vấn Dinh Dưỡng, Calo/BMI &amp; Nguyên Liệu Thay Thế)" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=32;horizontal=1;horizontalStack=1;whiteSpace=wrap;fillColor=#f8f9fa;strokeColor=#333333;fontStyle=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1120" height="2050" as="geometry" />
        </mxCell>
        <mxCell id="lane_SWP391_GUEST_03_0" value="User / Khách Vãng Lai (Actor)" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" vertex="1" parent="pool_SWP391_GUEST_03">
          <mxGeometry x="0" y="32" width="280" height="2018" as="geometry" />
        </mxCell>
        <mxCell id="lane_SWP391_GUEST_03_1" value="React Frontend (Client)" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" vertex="1" parent="pool_SWP391_GUEST_03">
          <mxGeometry x="280" y="32" width="280" height="2018" as="geometry" />
        </mxCell>
        <mxCell id="lane_SWP391_GUEST_03_2" value="ASP.NET Core Backend" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" vertex="1" parent="pool_SWP391_GUEST_03">
          <mxGeometry x="560" y="32" width="280" height="2018" as="geometry" />
        </mxCell>
        <mxCell id="lane_SWP391_GUEST_03_3" value="Database &amp; Gemini 2.5 Flash API" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" vertex="1" parent="pool_SWP391_GUEST_03">
          <mxGeometry x="840" y="32" width="280" height="2018" as="geometry" />
        </mxCell>
        <mxCell id="cell_10" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="lane_SWP391_GUEST_03_0">
          <mxGeometry x="128.0" y="48" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell_11" value="1. Bấm vào Widget AI Nutrition Chatbot ở góc dưới màn hình ứng dụng" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_0">
          <mxGeometry x="25.0" y="98" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_12" value="2. Khởi tạo Widget Chatbot, đọc biến guest_chatbot_count từ LocalStorage" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="168" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_13" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.4;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="120.0" y="238" width="40" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cell_14" value="Khóa khung chat, thông báo lỗi: ERR_BR2_CHATBOT_QUOTA_EXCEEDED" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="25.0" y="308" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_15" value="✕" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="127.0" y="383" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cell_15_lbl" value="Flow Final (Khóa phiên vãng lai)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444444;fontStyle=1;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="97.0" y="411" width="86" height="18" as="geometry" />
        </mxCell>
        <mxCell id="cell_16" value="3. Mở khung chat, hiển thị lời chào chuyên gia &amp; số lượt dùng thử còn lại" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="338" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_17" value="4. Nhập câu hỏi tư vấn dinh dưỡng: Calo/BMI, nguồn đạm chay, dị ứng" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_0">
          <mxGeometry x="25.0" y="408" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_18" value="5. Validate độ dài câu hỏi (1-500 ký tự), bật hiệu ứng Typing Indicator" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="478" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_19" value="6. Gửi request tư vấn dinh dưỡng: POST /api/v1/public/chatbot/guest-query" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="548" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_20" value="7. Tiếp nhận request, kiểm tra IP Rate Limit (RATE_LIMIT_EXCEEDED)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="25.0" y="618" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_21" value="8. Đọc lịch sử 3 tin nhắn gần nhất &amp; tiêm System Prompt Dinh dưỡng (BR6)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="25.0" y="688" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_22" value="9. Gửi prompt đa phương thức tới Gemini 2.5 Flash API" style="html=1;shape=mxgraph.infographic.ribbonSimple;notch1=0;notch2=20;align=center;verticalAlign=middle;fontSize=10.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;whiteSpace=wrap;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="30.0" y="758" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cell_23" value="Timeout 15s chờ AI" style="shape=hourglass;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;fontColor=#000000;fontFamily=Helvetica;strokeWidth=1.3;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=#ffffff;" vertex="1" parent="lane_SWP391_GUEST_03_3">
          <mxGeometry x="118.0" y="828" width="44" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_24" value="10. Nhận kết quả tư vấn dinh dưỡng từ Google Gemini API" style="html=1;shape=mxgraph.infographic.ribbonSimple;notch1=20;notch2=0;align=center;verticalAlign=middle;fontSize=10.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;spacingLeft=14;whiteSpace=wrap;" vertex="1" parent="lane_SWP391_GUEST_03_3">
          <mxGeometry x="30.0" y="898" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cell_25" value="" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.4;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="120.0" y="968" width="40" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cell_26" value="Trả về phản hồi mềm (Circuit Breaker): 'Chuyên gia AI bận, vui lòng thử lại'" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="1038" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_27" value="✕" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;verticalAlign=middle;align=center;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="127.0" y="1108" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="cell_27_lbl" value="Flow Final (Lỗi dịch vụ AI)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444444;fontStyle=1;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="97.0" y="1136" width="86" height="18" as="geometry" />
        </mxCell>
        <mxCell id="cell_28" value="" style="html=1;shape=rect;fillColor=#000000;strokeColor=none;rounded=0;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="40.0" y="1073" width="200" height="6" as="geometry" />
        </mxCell>
        <mxCell id="cell_29" value="11a. Chuẩn hóa câu trả lời Markdown (Bảng calo, danh sách món, lưu ý y khoa)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="25.0" y="1113" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_30" value="11b. Ghi nhật ký hội thoại &amp; giám sát token AI vào Database" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_3">
          <mxGeometry x="25.0" y="1113" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_31" value="" style="html=1;shape=rect;fillColor=#000000;strokeColor=none;rounded=0;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="40.0" y="1183" width="200" height="6" as="geometry" />
        </mxCell>
        <mxCell id="cell_32" value="Tin nhắn tư vấn [Hoàn tất]" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;fontStyle=0;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="50.0" y="1223" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="cell_33" value="12. Trả về HTTP 200 JSON cho Frontend" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_2">
          <mxGeometry x="25.0" y="1283" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_34" value="13. Render câu trả lời Markdown, tăng biến guest_chatbot_count" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_1">
          <mxGeometry x="25.0" y="1353" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cell_35" value="14. Đọc phản hồi dinh dưỡng từ AI trên giao diện trò chuyện" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_0">
