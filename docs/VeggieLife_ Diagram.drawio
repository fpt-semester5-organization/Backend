                </mxCell>
                <mxCell id="lane_SWP391_GUEST_03_0" value="User / Khách Vãng Lai (Actor)" style="swimlane;html=1;startSize=28;strokeColor=#666666;fillColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;fontColor=#111111;collapsible=0;" parent="pool_SWP391_GUEST_03" vertex="1">
                    <mxGeometry y="32" width="280" height="2018" as="geometry"/>
                </mxCell>
                <mxCell id="cell_10" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="128" y="48" width="24" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="cell_11" value="1. Bấm vào Widget AI Nutrition Chatbot ở góc dưới màn hình ứng dụng" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="25" y="98" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_17" value="4. Nhập câu hỏi tư vấn dinh dưỡng: Calo/BMI, nguồn đạm chay, dị ứng" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="25" y="408" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_35" value="14. Đọc phản hồi dinh dưỡng từ AI trên giao diện trò chuyện" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="25" y="1423" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_37" value="15a. Cập nhật badge số lượt còn lại &amp; sẵn sàng nhận câu hỏi tiếp theo" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="25" y="1568" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_38" value="✕" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontSize=15;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;verticalAlign=middle;align=center;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="127" y="1638" width="26" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="cell_38_lbl" value="Flow Final (Hoàn tất câu hỏi, sẵn sàng tiếp tục)" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#444444;fontStyle=1;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="97" y="1666" width="86" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="cell_41" value="17. Bấm nút 'Đăng ký ngay' trên Modal Popup để tiếp tục" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_0" vertex="1">
                    <mxGeometry x="25" y="1728" width="230" height="48" as="geometry"/>
                </mxCell>
