                <mxCell id="c09A5CiMH4nLQF5eZN43-31" value="14a. Báo lỗi: Mật khẩu yếu (&lt;8 ký tự/thiếu hoa, số)&lt;br&gt;hoặc Email đã tồn tại (ERR_BR_AUTH_003)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-15" vertex="1">
