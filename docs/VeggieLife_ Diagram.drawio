                    <mxGeometry x="128" y="48" width="24" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-4" value="1. Truy cập trang chủ &amp;&#10;lướt xem bài viết/video" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
                    <mxGeometry x="25" y="103" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-5" value="2. Chọn xem chi tiết&#10;công thức nấu món chay" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
