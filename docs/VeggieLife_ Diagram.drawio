                <mxCell id="TCuF7hKxSWRVQA1xztNk-4" value="1. Mở không gian ẩm thực&amp;#xa;và tương tác cộng đồng" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="TCuF7hKxSWRVQA1xztNk-2" vertex="1">
