          <mxGeometry x="120.0" y="1498" width="40" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cell_37" value="15a. Cập nhật badge số lượt còn lại &amp; sẵn sàng nhận câu hỏi tiếp theo" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" vertex="1" parent="lane_SWP391_GUEST_03_0">
