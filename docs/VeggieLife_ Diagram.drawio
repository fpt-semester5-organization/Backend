                    <mxGeometry x="30" y="488" width="220" height="6" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-7" value="6a. Chọn [Tìm quán quanh đây]&#10;(≤ 3 lần, 5km qua GPS)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
                    <mxGeometry x="35" y="558" width="210" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-8" value="6b. Chọn [Quét Barcode]&#10;(≤ 3 lần, soi phụ gia E-Nums)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
                    <mxGeometry x="35" y="643" width="210" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c09A5CiMH4nLQF5eZN43-9" value="6c. Chọn [Tóm tắt video]&#10;(≤ 3 lần, trích xuất text)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
                    <mxGeometry x="35" y="728" width="210" height="48" as="geometry"/>
                </mxCell>
