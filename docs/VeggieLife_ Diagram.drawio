                <mxCell id="c09A5CiMH4nLQF5eZN43-13" value="16. Nhận mã OTP từ Email&lt;br&gt;&amp;amp; nhập vào ô xác thực" style="html=1;shape=mxgraph.infographic.ribbonSimple;notch1=20;notch2=0;align=center;verticalAlign=middle;fontSize=10.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;spacingLeft=14;whiteSpace=wrap;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
