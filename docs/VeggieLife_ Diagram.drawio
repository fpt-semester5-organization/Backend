                <mxCell id="c09A5CiMH4nLQF5eZN43-19" value="7. Gửi yêu cầu tính năng dùng thử&#10;kèm Guest Session ID" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-15" vertex="1">
