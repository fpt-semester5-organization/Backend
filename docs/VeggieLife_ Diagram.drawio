                <mxCell id="c09A5CiMH4nLQF5eZN43-14" value="19. Nhập profile: chiều cao, cân nặng,&lt;br&gt;tuổi, trường phái chay (SĐT tùy chọn)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-2" vertex="1">
