                <mxCell id="cell_39" value="15b. Khóa ô nhập tin nhắn, hiển thị cảnh báo chạm trần 5 câu (BR2-A)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_1" vertex="1">
