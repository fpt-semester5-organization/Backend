                    <mxGeometry x="25" y="338" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_18" value="5. Validate độ dài câu hỏi (1-500 ký tự), bật hiệu ứng Typing Indicator" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_1" vertex="1">
                    <mxGeometry x="25" y="478" width="230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="cell_19" value="6. Gửi request tư vấn dinh dưỡng: POST /api/v1/public/chatbot/guest-query" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_1" vertex="1">
