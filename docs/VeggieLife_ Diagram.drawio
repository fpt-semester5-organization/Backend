                <mxCell id="c09A5CiMH4nLQF5eZN43-41" value="14. Kiểm tra dữ liệu Form đăng ký&lt;br&gt;(BR-AUTH-001 &amp;amp; BR-USR-AUTH-02)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="c09A5CiMH4nLQF5eZN43-37" vertex="1">
