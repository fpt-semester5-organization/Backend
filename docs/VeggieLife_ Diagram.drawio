                    <mxGeometry x="280" y="32" width="280" height="2018" as="geometry"/>
                </mxCell>
                <mxCell id="cell_12" value="2. Khởi tạo Widget Chatbot, đọc biến guest_chatbot_count từ LocalStorage" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=11.5;strokeColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontColor=#000000;strokeWidth=1.3;" parent="lane_SWP391_GUEST_03_1" vertex="1">
