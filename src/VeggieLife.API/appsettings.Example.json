{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=VeggieLifeDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "VeggieLife.API",
    "Audience": "VeggieLife.Client",
    "AccessTokenExpiryMinutes": 15
  },
  "GuestSecurity": {
    "RateLimitPerMinute": 10,
    "BanDurationMinutes": 10,
    "EnforceVietnamOnly": false,
    "AllowedCountryCodes": [
      "VN"
    ]
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "VeggieLife",
    "Audience": "VeggieLifeUsers",
    "ExpiryMinutes": 1440
  },
  "AiService": {
    "BaseUrl": "http://localhost:8080",
    "InternalApiKey": "YOUR_INTERNAL_AI_SERVICE_API_KEY"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY_HERE"
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",
    "MapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
  },
  "Cloudinary": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "Payment": {
    "MoMo": {
      "PartnerCode": "YOUR_MOMO_PARTNER_CODE",
      "AccessKey": "YOUR_MOMO_ACCESS_KEY",
      "SecretKey": "YOUR_MOMO_SECRET_KEY"
    },
    "VietQR": {
      "ApiKey": "YOUR_VIETQR_API_KEY",
      "ClientId": "YOUR_VIETQR_CLIENT_ID"
    }
  },
  "Smtp": {
    "ActiveProvider": "Auto",
    "Resend": {
      "Host": "smtp.resend.com",
      "Port": 587,
      "User": "resend",
      "Password": "YOUR_RESEND_API_KEY_STARTING_WITH_RE",
      "From": "onboarding@resend.dev",
      "DisplayName": "VeggieLife",
      "EnableSsl": true
    },
    "SendGrid": {
      "Host": "smtp.sendgrid.net",
      "Port": 587,
      "User": "apikey",
      "Password": "YOUR_SENDGRID_API_KEY_STARTING_WITH_SG",
      "From": "YOUR_VERIFIED_SENDER_EMAIL@gmail.com",
      "DisplayName": "VeggieLife",
      "EnableSsl": true
    },
    "Gmail": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "User": "YOUR_GMAIL_ADDRESS@gmail.com",
      "Password": "YOUR_16_CHAR_GOOGLE_APP_PASSWORD",
      "From": "YOUR_GMAIL_ADDRESS@gmail.com",
      "DisplayName": "VeggieLife",
      "EnableSsl": true
    },
    "Mailtrap": {
      "Host": "sandbox.smtp.mailtrap.io",
      "Port": 587,
      "User": "YOUR_MAILTRAP_USERNAME",
      "Password": "YOUR_MAILTRAP_PASSWORD",
      "From": "noreply@veggielife.vn",
      "DisplayName": "VeggieLife",
      "EnableSsl": true
    }
  },
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org",
    "TimeoutSeconds": 3,
    "UserAgent": "VeggieLife/1.0 (Web/Mobile; https://veggielife.vn; support@veggielife.vn)"
  }
}